# ---- Application ----
ENVIRONMENT=development

# ---- Database ----
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DIRECT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME_test?sslmode=require

# ---- Auth ----
JWT_SECRET_KEY=replace-with-48-bytes-of-random-urlsafe-text

# ---- Google Gemini ----
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ---- RAG ----
EMBEDDING_DIM=768
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
INLINE_SYNC_MAX_CHARS=20000
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55
RAG_FAITHFULNESS_MIN=0.70
RAG_RELEVANCY_MIN=0.70

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000